  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "start": "webpack serve --mode development",
    "build": "webpack --mode production",
    "analyze": "webpack-bundle-analyzer dist/main.js.LICENSE.txt --mode static",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:summary": "vitest run --coverage --reporter=json-summary --reporter=default",
